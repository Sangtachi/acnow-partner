# Vercel / 프로덕션 빌드 시 필수: Nest API의 origin 만 (끝 슬래시·/api 없음)
# 예: https://your-api.railway.app  또는  https://api.yourdomain.com
# 미설정 시 브라우저가 127.0.0.1:4000 으로 가거나 동일 출처 /api 만 호출해 로그인 실패합니다.
VITE_API_BASE_URL=

# 로컬 npm run dev: Vite 프록시가 /api → Nest 로 넘깁니다.
# VITE_API_BASE_URL 을 비우면 위 기본(http://127.0.0.1:4000)이 프록시 대상이 됩니다.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:4000
